{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abdul-barber",
  "main": "./worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "secrets": {
    "required": ["ADMIN_PIN"]
  },
  "observability": {
    "enabled": true
  }
}
