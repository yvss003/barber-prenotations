{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abdul-barber",
  "main": "./worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abdul-barber",
      "database_id": "3c3f1e12-df6b-421a-a611-ca6227081718"
    }
  ],
  "observability": {
    "enabled": true
  }
}
